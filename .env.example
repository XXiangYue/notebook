# Application
APP_ENV=development
APP_NAME=Notebook
API_HOST=127.0.0.1
API_PORT=8000
WEB_PORT=3000
LOG_LEVEL=INFO

# PostgreSQL
POSTGRES_DB=notebook
POSTGRES_USER=notebook
POSTGRES_PASSWORD=notebook_dev_password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://notebook:notebook_dev_password@127.0.0.1:5432/notebook

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0

# Local file storage
STORAGE_ROOT=./data
MAX_ATTACHMENT_BYTES=10485760
ALLOWED_ATTACHMENT_TYPES=image/png,image/jpeg,image/gif,image/webp,text/plain,text/markdown,application/pdf

# Browser-visible API address
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# AI organizer. Keep local for offline development, or set to minimax/deepseek.
AI_ORGANIZER_SETTINGS_PATH=
ORGANIZER_PROVIDER=local
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/anthropic
MINIMAX_MODEL=MiniMax-M3
MINIMAX_MAX_TOKENS=8192
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_MAX_TOKENS=8192
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_THINKING_ENABLED=false

# Embeddings. Local provider is deterministic and offline for MVP development.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=local-hash-embedding-v1
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BASE_URL=https://api.minimaxi.com/v1
EMBEDDING_API_KEY=
EMBEDDING_GROUP_ID=
EMBEDDING_TIMEOUT_SECONDS=30
